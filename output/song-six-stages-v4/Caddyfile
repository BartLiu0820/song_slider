# 滑动变祖器 · 静态站点
# Caddy 的 file_server 自带 Range 请求支持（视频拖动定位必需），无需额外配置

:80 {
	root * /srv
	file_server
	encode zstd gzip

	# 静态资源缓存 7 天并允许过期后后台更新；HTML 不缓存，方便发版
	@assets path *.mp4 *.m4a *.jpg
	header @assets Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
	@html path *.html /
	header @html Cache-Control "no-cache"
}

# 有域名时改用下面的形式，Caddy 自动签发 HTTPS 证书：
# slider.example.com {
# 	root * /srv
# 	file_server
# 	encode zstd gzip
# }
