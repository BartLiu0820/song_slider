[Unit]
Description=Read-only Git snapshot transport for local deployment containers
After=docker.service
Requires=docker.service

[Service]
User=song-deploy
Group=song-deploy
ExecStart=/usr/bin/python3 -m http.server 9418 --bind 172.21.0.1 --directory /var/lib/song-deploy/repos
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
InaccessiblePaths=/etc/song-deploy
ReadOnlyPaths=/var/lib/song-deploy
MemoryMax=192M
TasksMax=24

[Install]
WantedBy=multi-user.target
