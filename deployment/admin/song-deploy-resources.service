[Unit]
Description=Song read-only server resource snapshot
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/song-deploy/admin/resources.py
RuntimeDirectory=song-deploy-metrics
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=240
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/run/song-deploy-metrics
